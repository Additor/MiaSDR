          "type": "string",
        },
        "replyTypePickId": {
          "type": "string",
        },
        "threadId": {
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "set_reply_type",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {},
        "contextVersion": {},
        "conversationId": {},
        "draftsRetired": {},
        "error": {},
        "followUpsEnded": {},
        "followUpsStarted": {},
      },
      "type": "object",
    },
    "title": "Set reply type",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Stops every queued cell of a table, whoever started it. A cell already calling a provider finishes. It spends nothing and a person can run them again.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "tableId": {
          "type": "string",
        },
      },
      "required": [
        "tableId",
      ],
      "type": "object",
    },
    "name": "stop_enrichment",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
