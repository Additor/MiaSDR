# Copy to .env. Make each secret with: openssl rand -hex 32

APP_URL=http://localhost:3000
PORT=3000

POSTGRES_PASSWORD=CHANGEME
BETTER_AUTH_SECRET=CHANGEME
INTEGRATION_CREDENTIALS_KEY=CHANGEME
UNSUBSCRIBE_SECRET=CHANGEME

# Optional
# Old credential keys during a rotation, comma separated (32+ characters each). See docs/operations.md, Rotating the credential key.
INTEGRATION_CREDENTIALS_LEGACY_KEYS=
CRON_SECRET=
AUTH_SIGNUP=invite-only
# Domains whose addresses may be connected as mailboxes (comma list). The service account can read and send as
# any address in your Workspace, so set this to the domains tenants own. Required when AUTH_SIGNUP=open.
# MAILBOX_ALLOWED_DOMAINS=example.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DB_POOL_MAX=8
# Demo only: `fake` keeps mail in memory and never sends anything.
MAILBOX_PROVIDER=
# LinkedIn runs through Unipile (the one paid service). Each organization stores its DSN and key in Settings, LinkedIn. `fake` is for demos.
LINKEDIN_PROVIDER=
# Extra Unipile DSN hosts besides *.unipile.com (comma list: host, host:port or *.domain). Leave empty unless Unipile gives you a custom domain.
LINKEDIN_DSN_ALLOWED_HOSTS=
# AI: each organization stores its own Anthropic key in Settings, Integrations.
# Demo only: `fake` answers every organization with a keyword classifier and template drafts (nothing leaves the machine).
AI_PROVIDER=
# Model id used when the integration sets none. Default claude-sonnet-5-5.
AI_MODEL=
# Grid (Tables) enrichment. `fake` is a deterministic demo provider; leave empty in production.
GRID_PROVIDER=
# Hosts a Custom HTTP enrichment provider may call (comma list: host, host:port or *.domain). Empty means none can.
GRID_HTTP_ALLOWED_HOSTS=
# Grid cells run at the same time per tick, 1 to 16 (default 8).
GRID_RUN_CONCURRENCY=
# Gmail: set MAILBOX_PROVIDER=gmail and give the service account key (domain-wide delegation) one way:
# raw JSON on one line, or a path to the key file inside the container.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Scheduler and migrations: both default to on. Accepts true/false, 1/0, yes/no, on/off in any case. Set false to run
# them yourself: `pnpm db:migrate` (or `node scripts/migrate.mjs` in the image) and an external call to /api/jobs/tick.
RUN_MIGRATIONS=
EMBEDDED_SCHEDULER=
# Emergency brake. true holds automated sequence sends (email and LinkedIn) and test sends; replies you approve still
# send, and inbound sync keeps running. A value the app cannot read counts as true. Default off.
# See docs/operations.md, Pause all sending.
PAUSE_OUTBOUND=

# Country for phone numbers written without a country code, e.g. KR so 010-1234-5678 is kept. Two letters. An organization setting overrides it.
# DEFAULT_PHONE_COUNTRY=KR

# History pruning, in days. Only logs are pruned (job runs, finished provider events, finished AI jobs, expired sessions). Sends, messages, enrollments and suppression are never deleted.
# RETENTION_JOB_RUNS_DAYS=30
# RETENTION_INBOUND_EVENTS_DAYS=30
# Dead-lettered provider events (status failed) stay longer.
# RETENTION_INBOUND_FAILED_DAYS=90
# RETENTION_AI_JOBS_DAYS=30

# External database: use docker-compose.external-db.yml (app only) with DATABASE_URL and DATABASE_SSL set, and select it with
# COMPOSE_FILE=docker-compose.external-db.yml. POSTGRES_PASSWORD is not needed then. See docs/configuration.md.
# COMPOSE_FILE=docker-compose.external-db.yml

# Local development without Docker for the app (compose db only):
# DATABASE_URL=postgres://miasdr:CHANGEME@localhost:5432/miasdr
# DATABASE_SSL=disable
